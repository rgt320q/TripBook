rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile images: Everyone can see them, but only the owner can upload/change their own
    match /profile_images/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /profile_images/{userId}_{timestamp}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default fallback: Block everything else unless explicitly allowed
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
